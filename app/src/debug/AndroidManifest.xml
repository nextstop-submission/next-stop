<?xml version="1.0" encoding="utf-8"?>
<!-- debug 빌드 전용: 실측 화면. release APK에는 이 화면·진입 버튼이 없다.
     실측 스크립트(scripts/probe/*)와 CI는 debug APK를 설치해 adb로 연다. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 실측 화면에서 Vehicle Service 버전 확인용 -->
    <queries>
        <package android:name="ai.pleos.playground.service.vehicle" />
    </queries>

    <application>
        <!-- 정차 중 개발용이므로 distractionOptimized 아님. adb(shell)로 열어야 해서 exported -->
        <activity
            android:name=".probe.ProbeActivity"
            android:exported="true"
            android:label="@string/probe_name" />
    </application>
</manifest>
